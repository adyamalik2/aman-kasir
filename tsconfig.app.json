{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Vite yang handle transpilasi, TS hanya type-check */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict mode — wajib aktif sejak hari pertama (blueprint Bab 8) */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path alias — @/ = src/ */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Types global untuk Vitest (globals: true di vitest config) */
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
